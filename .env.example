# Supabase Client Configuration (Vercel & Local)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Supabase server configuration (required by the /api routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Cloudinary server configuration (required by the /api routes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin password OTP delivery (server-side only; never prefix with VITE_)
# Leave SMTP_HOST blank to fall back to the Supabase email OTP flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MMG Trust

# Address that receives the OTP while testing. Leave blank to use the admin email.
OTP_RECIPIENT_EMAIL=
# Signs the OTP challenge. Defaults to SMTP_PASS when left blank.
OTP_SECRET=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_EMAIL_SUBJECT=Your admin password verification code