# Supabase Client Configuration (Vercel & Local)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Aliases also supported by vite.config.js:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Server-Side Email Integration (Vercel Serverless Function / Supabase Secret)
# DO NOT prefix with VITE_ to keep it private and secure on the server!
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_RECIPIENT_EMAIL=sonofsoiltrust@gmail.com
SENDER_EMAIL=onboarding@resend.dev

